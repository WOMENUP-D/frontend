NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Firebase (Google sign-in) ---
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# Every value here is public: a Firebase web config ships in the page source of
# every app that uses it. What protects the project is the authorised-domain
# list plus the token check on our API — never put the service-account private
# key in a NEXT_PUBLIC_ variable.
# Empty means the Google button is not rendered at all.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only needed if the portal later uses Firebase storage/messaging.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=

# --- Demonstration build ---
# "true" shows the DEMO banner and the list of ready-made sign-in accounts.
# Leave empty for anything a real woman will open: that list publishes a
# working password.
NEXT_PUBLIC_DEMO=
